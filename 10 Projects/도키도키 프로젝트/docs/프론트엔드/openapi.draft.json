      "AnimeId": {
        "name": "animeId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "RecordId": {
        "name": "recordId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "Query": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 100,
          "default": ""
        },
        "description": "앞뒤 공백 제거 후 제목 부분 검색. 빈 문자열은 초기 목록입니다."
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "이전 응답 nextCursor. 검색 조건이 달라지면 제거합니다."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      },
      "Status": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "completed",
            "stopped"
          ]
        },
        "description": "전체 조회는 생략합니다."
      },
      "Csrf": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "Version": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        },
        "example": "\"1\"",
        "description": "조회한 record.version의 따옴표 포함 문자열. 충돌 412, 누락 428입니다."
      },
      "Idempotency": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "사용자별 24시간 보관 가정. 동일 body 재시도는 같은 키, 다른 body는 새 키입니다."
      }
    },
