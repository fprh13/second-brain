# 옵시디언 rules 정의

## git add & commit 허용

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging changes without prompting.",
    match = [
        "git add .",
        "git add -A",
        "git add README.md",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow local commits without prompting.",
    match = [
        'git commit -m "notes: sync"',
        "git commit --amend",
    ],
)


## 옵시디언 저장 스크립트 허용
prefix_rule(
    pattern = ["bash", ".codex/skills/obsidian-save/scripts/obsidian_save.sh"],
    decision = "allow",
    justification = "Obsidian 노트 저장 및 동기화를 위한 스크립트입니다.",
    match = [
      "bash .codex/skills/obsidian-save/scripts/obsidian_save.sh",
    ],
)

## git push 허락

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Always ask before pushing to a remote.",
    match = [
        "git push",
        "git push origin main",
        "git push --force-with-lease",
    ],
)
